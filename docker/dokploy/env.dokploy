# MessageLoop × mlbridge —— Dokploy Environment 变量模板
#
# 用法（二选一）：
#   1. Dokploy 部署：把本文件内容整段复制进 Compose 服务的「Environment」
#      页签，填齐「必填」段的五项后部署。Environment 页签里的变量既参与
#      compose 插值，也注入容器环境——这是生产部署的唯一密钥入口，不要把
#      填好的文件提交进 git。
#   2. 本地校验：填好必填项后
#      docker compose --env-file env.dokploy -f docker-compose.yml config
#      能渲染即插值链完整；不填必填项则会得到对应的中文报错（插值守卫）。
#
# 与 compose 的对应关系：compose 里所有 ${VAR:?…} / ${VAR:-default} 引用都
# 收口在本文件；改默认值应两处同步（README §2 有逐项说明）。

# ========== 必填（不设拒绝启动/路由；默认注释占位） ==========

# admin gRPC 的 Bearer token（列表键，逗号分隔多把）；mlbridge 调 admin 面
# （撤销断连 + 写穿扇出）复用同一值。生成：openssl rand -hex 32
#MESSAGELOOP_SERVER_GRPC_ADMIN_AUTH_TOKENS=

# WebSocket 域名（Traefik 路由，wss://<域名>/ws）
#MESSAGELOOP_WS_DOMAIN=ws.example.com

# 客户端 gRPC 域名（Traefik 终结 TLS 后 h2c 转发）
#MESSAGELOOP_GRPC_DOMAIN=grpc.example.com

# Torchwood 网关地址（mlbridge 校验凭证/读写策略与档案/上报计量）。
# 与 Torchwood 同机 Dokploy 部署走 dokploy-network 内网直连（容器名别名，
# 没有 "torchwood" 这个名字）；跨机/独立部署用公网网关。
#MLBRIDGE_TORCHWOOD_BASE_URL=http://torchwood-server:9080

# 项目凭证 JSON 数组。key 需含 scopes：users.read、databases.read/write、
# runbooks.read/write、analytics.write（资源供给用 mlbridge 仓库 runbooks/）。
#MLBRIDGE_TORCHWOOD_PROJECTS=[{"project_id":"myproj","api_key":"sk-..."}]

# ========== 可选（缺省值与 compose 默认一致；按需取消注释覆盖） ==========

# —— 镜像版本（建议钉 semver tag 而非 latest；回滚 = 钉旧 tag）——
#MESSAGELOOP_IMAGE=ghcr.io/messageloopio/messageloop:latest
#MLBRIDGE_IMAGE=ghcr.io/messageloopio/mlbridge:latest

# —— 栈内 redis（仅 default 内网可达；接外部 redis 改 addr 并配套密码）——
#MESSAGELOOP_BROKER_REDIS_PASSWORD=
#MESSAGELOOP_BROKER_REDIS_DB=0
#MESSAGELOOP_BROKER_REDIS_STREAM_MAX_LENGTH=10000
#MLBRIDGE_REDIS_DB=0

# —— admin / health ——
# /health、/metrics 的 Bearer token。8080 默认绑回环（compose），不发布不
# 路由；若改为非回环绑定（如 0.0.0.0:8080）【必须】设置本项（G5 fail-closed，
# 无 token 拒绝启动），并同步改 compose 里 messageloop 的 healthcheck
#MESSAGELOOP_SERVER_HTTP_AUTH_TOKEN=

# —— WebSocket 跨域 ——
# 默认放开（token 鉴权下 Origin 不是授权边界）；收紧 = 逗号分隔白名单
# 且必须同时设 ALLOW_ALL_ORIGINS=false（allow_all 优先级更高）
#MESSAGELOOP_TRANSPORT_WEBSOCKET_ALLOW_ALL_ORIGINS=true
#MESSAGELOOP_TRANSPORT_WEBSOCKET_ALLOWED_ORIGINS=

# —— 宿主回环端口（公网流量走 Traefik 域名，回环仅供 SSH 隧道兜底）——
#MESSAGELOOP_GRPC_PORT=9090
#MESSAGELOOP_ADMIN_GRPC_PORT=9091

# —— mlbridge 行为 ——
# 凭证复验环间隔；撤销上界 = 复验间隔 + TW 校验缓存 30s
#MLBRIDGE_REVALIDATE_INTERVAL=5m
# 用量计量（批量上报 TW analytics）
#MLBRIDGE_METERING_ENABLED=true
#MLBRIDGE_METERING_FLUSH_INTERVAL=15s
# 写穿：send RPC 先落 TW 文档再经 admin 面扇出；channels 是 JSON 数组，
# 通配语言与 ML 频道一致（不带命名空间前缀）
#MLBRIDGE_WRITE_THROUGH_ENABLED=true
#MLBRIDGE_WRITE_THROUGH_DATABASE=messageloop
#MLBRIDGE_WRITE_THROUGH_COLLECTION=messages
#MLBRIDGE_WRITE_THROUGH_CHANNELS=["**"]

# ========== 按需高级项（compose 内为注释行，需同步放开） ==========

# UDP 传输：Traefik 不路由 UDP，设地址后还需放开 compose 里 ports 的
# 对应注释行并配置 TLS 证书（见 README §4.3）
#MESSAGELOOP_TRANSPORT_QUIC_ADDR=
#MESSAGELOOP_TRANSPORT_KCP_ADDR=
#MESSAGELOOP_QUIC_PORT=4433
#MESSAGELOOP_KCP_PORT=29900
