        },
        "rpcReply": {
          "$ref": "#/definitions/clientv2RpcReply"
        },
        "subRefreshAck": {
          "$ref": "#/definitions/clientv2SubRefreshAck"
        },
        "surveyRequest": {
          "$ref": "#/definitions/messageloopclientv2SurveyRequest"
        },
        "surveyReply": {
          "$ref": "#/definitions/clientv2SurveyReply"
        },
        "surveyResult": {
          "$ref": "#/definitions/messageloopclientv2SurveyResult"
        },
        "presence": {
          "$ref": "#/definitions/clientv2PresenceSnapshot"
        },
        "presenceEvent": {
