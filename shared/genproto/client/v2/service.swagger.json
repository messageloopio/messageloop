    "application/json"
  ],
  "paths": {},
  "definitions": {
    "clientv2Connect": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string"
        },
        "clientType": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2Subscription"
          }
        },
        "sessionId": {
          "type": "string",
          "title": "上次会话 ID，为空表示新连接"
        },
        "caps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clientv2Connected": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
