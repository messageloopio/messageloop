          "type": "string"
        }
      }
    },
    "clientv2PublishAck": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "title": "消息 ID，便于追踪"
        },
        "position": {
          "$ref": "#/definitions/v2Position",
          "title": "transient / 无历史 → offset 缺省"
        }
      }
    },
    "clientv2RpcReply": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/sharedv2Payload"
        },
        "metadata": {
          "$ref": "#/definitions/sharedv2Metadata"
        },
        "error": {
          "$ref": "#/definitions/sharedv2Error"
        }
      }
    },
    "clientv2RpcRequest": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/sharedv2Payload"
        },
        "metadata": {
          "$ref": "#/definitions/sharedv2Metadata"
        }
      }
    },
    "clientv2SubRefresh": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clientv2SubRefreshAck": {
      "type": "object"
    },
    "clientv2Subscribe": {
      "type": "object",
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2Subscription"
          }
        }
      }
    },
    "clientv2SubscribeAck": {
      "type": "object",
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2Subscription"
          }
        },
        "recover": {
          "$ref": "#/definitions/v2RecoverState",
          "title": "批量里任一频道 pending 则 PENDING"
        },
        "streamEpoch": {
          "type": "string"
        },
        "presence": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2PresenceSnapshot"
          },
          "title": "仅精确且非 ephemeral"
        },
        "error": {
          "$ref": "#/definitions/sharedv2Error",
          "title": "仅 recover=FAILED 时"
        }
      }
    },
    "clientv2Subscription": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "ephemeral": {
          "type": "boolean"
        },
        "token": {
          "type": "string"
        },
        "recover": {
          "type": "boolean",
          "title": "是否需要恢复离线消息"
        },
        "cursor": {
          "$ref": "#/definitions/v2Position",
          "title": "恢复起点提示；unset 表示无提示"
        },
        "fresh": {
          "type": "boolean",
          "title": "显式从头；禁止用 cursor.offset==0 表示从头"
        }
      }
    },
    "clientv2SurveyAnswer": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/sharedv2Payload"
        },
        "metadata": {
          "$ref": "#/definitions/sharedv2Metadata"
        },
        "error": {
          "$ref": "#/definitions/sharedv2Error"
        }
      }
    },
    "clientv2SurveyReply": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/sharedv2Payload"
        },
        "metadata": {
          "$ref": "#/definitions/sharedv2Metadata"
        },
        "error": {
          "$ref": "#/definitions/sharedv2Error"
        }
      }
    },
    "clientv2Unsubscribe": {
      "type": "object",
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2Subscription"
          }
        }
      }
    },
    "clientv2UnsubscribeAck": {
      "type": "object",
      "properties": {
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2Subscription"
          }
        }
      }
    },
    "messageloopclientv2PresenceInfo": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "clientId": {
          "type": "string",
          "title": "Connect.client_id（设备/端），不是 session"
        },
        "connectedAt": {
          "type": "string",
          "format": "int64"
        }
      }
    },
    "messageloopclientv2Publication": {
      "type": "object",
      "properties": {
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2Message"
          }
        }
      }
    },
    "messageloopclientv2SurveyRequest": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/definitions/sharedv2Payload"
        },
        "metadata": {
          "$ref": "#/definitions/sharedv2Metadata"
        },
        "channel": {
          "type": "string"
        },
        "timeoutMs": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "messageloopclientv2SurveyResult": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/clientv2SurveyAnswer"
          }
        },
        "error": {
          "$ref": "#/definitions/sharedv2Error"
        }
      },
      "title": "客户端 Survey 汇总。与 server.v2.SurveyResult 同名不同包。"
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "protobufNullValue": {
      "type": "string",
      "enum": [
        "NULL_VALUE"
      ],
      "default": "NULL_VALUE",
      "description": "`NullValue` is a singleton enumeration to represent the null value for the\n`Value` type union.\n\nThe JSON representation for `NullValue` is JSON `null`.\n\n - NULL_VALUE: Null value."
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "sharedv2Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Well-known string codes (not an enum): AUTH_REQUIRED, AUTH_ERROR,\nRATE_LIMITED, RPC_TIMEOUT, PROXY_ERROR, NO_PROXY, BAD_REQUEST,\nPERMISSION_DENIED, POLICY_DENIED, RECOVER_FAILED, RECOVER_SKIPPED,\nSURVEY_DISABLED, SURVEY_TOO_MANY_SUBSCRIBERS, PATTERN_NOT_ROUTABLE."
        },
        "type": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "sharedv2Metadata": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "title": "统一的元数据类型"
    },
    "sharedv2Payload": {
      "type": "object",
      "properties": {
        "contentType": {
          "type": "string",
          "title": "数据内容类型 (e.g., \"application/json\", \"text/plain\", \"application/octet-stream\")"
        },
        "json": {
          "type": "object",
          "title": "JSON 对象，编码时可读"
        },
        "binary": {
          "type": "string",
          "format": "byte",
          "title": "二进制数据"
        },
        "text": {
          "type": "string",
          "title": "文本数据"
        }
      },
      "title": "统一的数据载荷类型"
    },
    "v2GapNotice": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "position": {
          "$ref": "#/definitions/v2Position"
        },
        "gapReason": {
          "$ref": "#/definitions/v2GapReason"
        }
      },
      "title": "GapNotice：重连 catch-up 检出洞（C6）。position = 最后已知安全位置；\noffset 缺省 = 未知。它是通知：不进消息流，不与回放消息排序。"
    },
    "v2GapReason": {
      "type": "string",
      "enum": [
        "GAP_REASON_UNSPECIFIED",
        "GAP_REASON_NONE",
        "GAP_REASON_HEAD_TRIMMED",
        "GAP_REASON_EMPTY_EXPIRED",
        "GAP_REASON_EPOCH_RESET",
        "GAP_REASON_MIDDLE",
        "GAP_REASON_REPLAY_TRUNCATED"
      ],
      "default": "GAP_REASON_UNSPECIFIED",
      "description": "- GAP_REASON_MIDDLE: 页内/保留区中间缺条目：相邻条目稠密 seq 不连续（C4）。\n - GAP_REASON_REPLAY_TRUNCATED: 重连 catch-up 回放批被 limit 截断：stream 仍有更新条目未送达（C6）。\n历史里还在，客户端可 recover 补齐。",
      "title": "恢复 / 历史读取时的缺口原因"
    },
    "v2Position": {
      "type": "object",
      "properties": {
        "streamEpoch": {
          "type": "string"
        },
        "offset": {
          "type": "string",
          "format": "uint64"
        }
      },
      "title": "流内位置：epoch + 偏移。offset 缺省 = unset（无历史 / transient）；\n禁止用 0 表示 unset 或「从头」。"
    },
    "v2RecoverComplete": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "position": {
          "$ref": "#/definitions/v2Position"
        },
        "truncated": {
          "type": "boolean"
        },
        "gap": {
          "type": "boolean"
        },
        "gapReason": {
          "$ref": "#/definitions/v2GapReason"
        },
        "error": {
          "$ref": "#/definitions/sharedv2Error",
          "title": "SKIPPED/FAILED 细节"
        }
      }
    },
    "v2RecoverState": {
      "type": "string",
      "enum": [
        "RECOVER_STATE_UNSPECIFIED",
        "RECOVER_STATE_NONE",
        "RECOVER_STATE_PENDING",
        "RECOVER_STATE_SKIPPED",
        "RECOVER_STATE_FAILED"
      ],
      "default": "RECOVER_STATE_UNSPECIFIED"
    }
  }
}
