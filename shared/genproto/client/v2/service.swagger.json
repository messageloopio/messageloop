        },
        "resumed": {
          "type": "boolean",
          "title": "是否成功恢复会话"
        },
        "streamEpoch": {
          "type": "string",
          "title": "broker 实例标识，用于防止重启后 offset 混淆"
        },
        "acceptedCaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "clientv2Message": {
