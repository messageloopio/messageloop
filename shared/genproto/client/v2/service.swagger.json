        },
        "ping": {
          "$ref": "#/definitions/clientv2Ping"
        },
        "pong": {
          "$ref": "#/definitions/clientv2Pong"
        },
        "gapNotice": {
          "$ref": "#/definitions/v2GapNotice"
        }
      },
      "title": "服务端 -\u003e 客户端"
    },
    "clientv2Ping": {
      "type": "object"
    },
    "clientv2Pong": {
      "type": "object"
    },
    "clientv2PresenceEvent": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "title": "始终是精确频道"
        },
        "action": {
          "type": "string",
          "title": "\"join\" | \"leave\""
        },
        "info": {
          "$ref": "#/definitions/messageloopclientv2PresenceInfo"
        },
        "gen": {
          "type": "string",
          "format": "uint64",
          "title": "OccupancyGen"
        }
      }
    },
    "clientv2PresenceQuery": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "title": "精确频道"
        }
      }
    },
    "clientv2PresenceSnapshot": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "clients": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/messageloopclientv2PresenceInfo"
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "occupancy": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "clientv2Publish": {
      "type": "object",
      "properties": {
        "channel": {
